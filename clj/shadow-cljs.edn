;; Studio UI build. Shares the portable .cljc core under src/ with the JVM server.
{:deps   {:aliases [:dev :cljs]}
 :builds {:app {:target     :browser
                :output-dir "resources/public/js"
                :asset-path "/js"
                :modules    {:main {:init-fn mangaka.cljs.app/init}}
                :devtools   {:http-root "resources/public"
                             :http-port 8280}}}}
