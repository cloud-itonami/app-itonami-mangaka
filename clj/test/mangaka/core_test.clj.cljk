    (testing "importGhosthacker ingests the asset graph into characters + scenes"
      (let [ag {:characters {:Nei {:id "nei" :name "Nei" :text_desc "platinum-blonde hacker girl"
                                   :personality "calm" :relationships {:Ren "best friend"}}}
                :scenes {:rens-room {:id "rens-room" :name "Ren's room"
                                     :text_desc "multi-monitor hacker den"}}}
            res ((h "ai.gftd.mangaka.importGhosthacker") {:asset-graph ag} nil)]
        (is (= ["char-nei"] (:characters res)))
        (is (= ["scene-rens-room"] (:scenes res)))
        (let [c (store/load-character store "char-nei")]
          (is (= "Nei" (:character/name c)))
          (is (= "platinum-blonde hacker girl" (:character/prompt c)))
          ;; rich metadata round-trips through the enrichment EDN blob
          (is (= "calm" (:personality (store/-read-string store (:character/enrichment c))))))
        (is (= "Ren's room" (:scene/name (store/load-scene store "scene-rens-room"))))))

    (testing "importGhosthacker reads the bundled asset_graph when no inline graph is given (the startup-seed source)"
      (when (.exists (java.io.File. "../data/ghosthacker/resources/asset_graph.json"))
        (let [res ((h "ai.gftd.mangaka.importGhosthacker") {} nil)]
          (is (= 5 (count (:characters res))))
          (is (= 6 (count (:scenes res))))
          (is (contains? (set (:characters res)) "char-yuto"))
          (is (= "Yuto Numano" (:character/name (store/load-character store "char-yuto")))))))

    (testing "asset read surface: generate → list → load characters & scenes"
      ((h "ai.gftd.mangaka.mangakaGenerateCharacter") {:name "Nei" :seed 1} nil)
      ((h "ai.gftd.mangaka.mangakaGenerateScene") {:prompt "rainy alley" :seed 1} nil)
      (let [chars ((h "ai.gftd.mangaka.listCharacters") {} nil)]
        (is (contains? (set (map :id (:characters chars))) "char-nei")))
      (is (seq (:scenes ((h "ai.gftd.mangaka.listScenes") {} nil))))
      (let [c ((h "ai.gftd.mangaka.loadCharacter") {:id "char-nei"} nil)]
        (is (= "Nei" (:character/name c)))
        (is (string? (:character/image-b64 c)))
        (is (not (contains? c :db/id)) "internal :db/id is not leaked"))
      (is (nil? ((h "ai.gftd.mangaka.loadCharacter") {:id "char-missing"} nil)))
      (is (= :bad-input
             (try ((h "ai.gftd.mangaka.loadScene") {} nil) :no-throw
                  (catch clojure.lang.ExceptionInfo e (:type (ex-data e)))))))

    (testing "deleteCharacter / deleteScene prune generated assets (idempotent; missing input → 400)"
      ((h "ai.gftd.mangaka.mangakaGenerateCharacter") {:name "Junk" :seed 1} nil)
      (let [sid (:scene-id ((h "ai.gftd.mangaka.mangakaGenerateScene") {:prompt "throwaway bg" :seed 1} nil))]
        (is (some? (store/load-character store "char-junk")))
        (is (some? (store/load-scene store sid)))
        ;; character delete
        (is (= {:id "char-junk" :deleted true} ((h "ai.gftd.mangaka.deleteCharacter") {:id "char-junk"} nil)))
        (is (nil? (store/load-character store "char-junk")) "character gone after delete")
        (is (not (contains? (set (map :id (:characters ((h "ai.gftd.mangaka.listCharacters") {} nil)))) "char-junk")))
        (is (= {:id "char-junk" :deleted false} ((h "ai.gftd.mangaka.deleteCharacter") {:id "char-junk"} nil))
            "idempotent")
        ;; scene delete
        (is (:deleted ((h "ai.gftd.mangaka.deleteScene") {:id sid} nil)))
        (is (nil? (store/load-scene store sid)) "scene gone after delete"))
      (is (= :bad-input
             (try ((h "ai.gftd.mangaka.deleteCharacter") {} nil) :no-throw
                  (catch clojure.lang.ExceptionInfo e (:type (ex-data e)))))))

    (testing "listRenders enumerates a document's rendered panels (no image payload)"
      ((h "ai.gftd.mangaka.saveDocument")
       {:id "rd" :page {:page/number 1 :page/panels
                        [{:panel/index 0 :panel/shot "wide" :panel/focal [":character/Nei"]}]}} nil)
      ((h "ai.gftd.mangaka.mangakaGeneratePanel") {:doc-id "rd" :panel-index 0} nil)
      (let [res ((h "ai.gftd.mangaka.listRenders") {:doc-id "rd"} nil)
            r (first (:renders res))]
        (is (= "rd" (:doc-id res)))
        (is (= "panel-rd-0" (:id r)))
        (is (= 0 (:index r)))
        (is (not (contains? r :image-b64)) "image payload excluded from listing"))
      (is (= :bad-input
             (try ((h "ai.gftd.mangaka.listRenders") {} nil) :no-throw
                  (catch clojure.lang.ExceptionInfo e (:type (ex-data e)))))))

    (testing "comfyRun rejects a non-map workflow with :bad-input"
      (is (= :bad-input
             (try ((h "ai.gftd.mangaka.comfyRun") {:workflow "not-a-map"} nil) :no-throw
                  (catch clojure.lang.ExceptionInfo e (:type (ex-data e)))))))

    (testing "list endpoints paginate (offset/limit/total per the repo convention)"
      (let [res ((h "ai.gftd.mangaka.listDocuments") {:limit 1} nil)]
        (is (= 1 (:limit res)))
        (is (= 0 (:offset res)))
        (is (int? (:total res)))
        (is (<= (count (:documents res)) 1) "limit slices the result"))
      (let [res ((h "ai.gftd.mangaka.listCharacters") {:offset 0 :limit 2} nil)]
        (is (= 2 (:limit res)))
        (is (<= (count (:characters res)) 2)))
      (let [res ((h "ai.gftd.mangaka.listScenes") {} nil)]
        (is (= 100 (:limit res)) "default limit")
        (is (int? (:total res))))
      (testing "bad offset/limit (JSON string, negative, garbage) coerce to safe defaults — never 500"
        ;; a JSON client may send {"limit":"1"}; "abc"/negative must not crash
        (let [res ((h "ai.gftd.mangaka.listDocuments") {:limit "1" :offset "0"} nil)]
          (is (= 1 (:limit res)) "string \"1\" coerced to 1")
          (is (<= (count (:documents res)) 1)))
        (let [res ((h "ai.gftd.mangaka.listCharacters") {:limit "abc" :offset -5} nil)]
          (is (= 100 (:limit res)) "non-numeric limit → default 100")
          (is (= 0 (:offset res)) "negative offset → clamped to 0"))))

    (testing "analyzeCharacterGraph surfaces the cast relationship graph"
      ((h "ai.gftd.mangaka.importGhosthacker")
       {:asset-graph {:characters {:Yuto {:id "yuto" :name "Yuto" :relationships {:Nei "classmate"}}
                                   :Nei  {:id "nei"  :name "Nei"  :relationships {:Yuto "classmate" :Ren "friend"}}}}} nil)
      (let [g ((h "ai.gftd.mangaka.analyzeCharacterGraph") {} nil)
            edges (set (:edges g))]
        (is (contains? (set (map :name (:nodes g))) "Yuto"))
        (is (contains? (set (map :name (:nodes g))) "Nei"))
        (is (contains? edges {:from "Yuto" :to "Nei" :rel "classmate"}))
        (is (contains? edges {:from "Nei" :to "Ren" :rel "friend"}))))

    (testing "documentsByCharacter queries the storyboard datoms over the graph"
      ((h "ai.gftd.mangaka.saveDocument") {:id "qd" :page sample-page} nil)  ; focal :character/Nei
      (let [res ((h "ai.gftd.mangaka.documentsByCharacter") {:character "Nei"} nil)]
        (is (= ":character/Nei" (:character res)))
        (is (contains? (set (:documents res)) "qd"))
        (is (= {:doc-id "qd" :index 0} (first (filter #(= "qd" (:doc-id %)) (:panels res))))))
      ;; case-insensitive: lowercase "nei" and full-ref forms resolve to the
      ;; canonical stored focal ref :character/Nei (the model's casing varies)
      (doseq [arg ["nei" "NEI" ":character/nei"]]
        (let [res ((h "ai.gftd.mangaka.documentsByCharacter") {:character arg} nil)]
          (is (= ":character/Nei" (:character res)) (str arg " resolves to canonical ref"))
          (is (contains? (set (:documents res)) "qd") (str arg " finds the document"))))
      (let [res ((h "ai.gftd.mangaka.documentsByCharacter") {:character ":character/Ghost"} nil)]
        (is (= [] (:documents res)))))

    (testing "documentsByScene queries which documents are set in a scene"
      (let [sid (:scene-id ((h "ai.gftd.mangaka.mangakaGenerateScene") {:prompt "scene-query bg" :seed 1} nil))]
        ((h "ai.gftd.mangaka.saveDocument")
         {:id "sceneq" :page {:page/panels [{:panel/index 0 :panel/rect [0 0 1 1] :panel/scene sid}]}} nil)
        (let [res ((h "ai.gftd.mangaka.documentsByScene") {:scene sid} nil)]
          (is (= sid (:scene res)))
          (is (contains? (set (:documents res)) "sceneq"))
          (is (= {:doc-id "sceneq" :index 0} (first (filter #(= "sceneq" (:doc-id %)) (:panels res))))
              "panel-level results mirror documentsByCharacter"))
        (is (= [] (:documents ((h "ai.gftd.mangaka.documentsByScene") {:scene "scene-nonexistent"} nil))))
        (is (= :bad-input
               (try ((h "ai.gftd.mangaka.documentsByScene") {} nil) :no-throw
                    (catch clojure.lang.ExceptionInfo e (:type (ex-data e))))))))

    (testing "stats returns Datalog-powered entity counts (delta-checked; shared store)"
      (let [before ((h "ai.gftd.mangaka.stats") {} nil)]
        ((h "ai.gftd.mangaka.saveDocument") {:id "stats-doc-xyz" :page {:page/number 1 :page/panels []}} nil)
        ((h "ai.gftd.mangaka.mangakaGenerateCharacter") {:name "StatsHeroXyz" :seed 1} nil)
        ((h "ai.gftd.mangaka.mangakaGenerateScene") {:prompt "stats alley xyz" :seed 1} nil)
        (let [after ((h "ai.gftd.mangaka.stats") {} nil)]
          (is (= (inc (:documents before)) (:documents after)))
          (is (= (inc (:characters before)) (:characters after)))
          (is (= (inc (:scenes before)) (:scenes after)))
          (is (contains? after :renders))
          (is (contains? after :page-renders)))))

    (testing "previewSvg renders a stored storyboard to an SVG string"
      ((h "ai.gftd.mangaka.saveDocument")
       {:id "pv" :page {:page/number 1 :page/title "Pv"
                        :page/panels [{:panel/index 0 :panel/rect [0.05 0.05 0.9 0.4] :panel/shot "wide"}]}} nil)
      (let [res ((h "ai.gftd.mangaka.previewSvg") {:doc-id "pv"} nil)]
        (is (= "pv" (:doc-id res)))
        (is (str/starts-with? (:svg res) "<svg"))
        (is (str/includes? (:svg res) "wide")))
      (is (= :bad-input
             (try ((h "ai.gftd.mangaka.previewSvg") {:doc-id "nope"} nil) :no-throw
                  (catch clojure.lang.ExceptionInfo e (:type (ex-data e)))))))

    (testing "kamiRenderFrame renders a stored storyboard through the KAMI clj engine"
      ((h "ai.gftd.mangaka.saveDocument")
       {:id "kf" :page {:page/number 1 :page/panels
                        [{:panel/index 0 :panel/rect [0.05 0.05 0.9 0.4]}]}} nil)
      (let [frame ((h "ai.gftd.mangaka.kamiRenderFrame") {:doc-id "kf"} nil)]
        (is (some? (:frame/camera frame)))
        (is (pos? (count (get-in frame [:frame/passes 0 :pass/draws])))))
      (is (= :bad-input
             (try ((h "ai.gftd.mangaka.kamiRenderFrame") {:doc-id "nope"} nil) :no-throw
                  (catch clojure.lang.ExceptionInfo e (:type (ex-data e)))))))

    (testing "comfy_run executes an arbitrary workflow through the engine"
      (let [wf {"a" {:class_type "PrimitiveInt" :inputs {:value 2}}
                "b" {:class_type "Add" :inputs {:a ["a" 0] :b 40}}
                "out" {:class_type "Preview" :inputs {:value ["b" 0]}}}
            res ((h "ai.gftd.mangaka.comfyRun") {:workflow wf} nil)]
        (is (= [42] (get-in res [:results "out"])))
        (is (some? (:run-id res)))))

    (testing "visionScorePanel critiques a rendered panel + stores the verdict"
      (let [p ((h "ai.gftd.mangaka.mangakaGeneratePanel") {:prompt "neon" :seed 1} nil)
            res ((h "ai.gftd.mangaka.visionScorePanel") {:panel-id (:panel-id p)} nil)]
        (is (= (:panel-id p) (:panel-id res)))
        (is (map? (:critique res)))
        (is (false? (:llm-applied res)))            ; offline mock → stub critique
        ;; critique persisted on the panel as datoms, image preserved
        (let [stored (store/load-panel store (:panel-id p))]
          (is (string? (:panel/image-b64 stored)))
          (is (map? (store/-read-string store (:panel/critique stored)))))))

    (testing "visionScorePanel on a missing panel is :bad-input"
      (is (= :bad-input
             (try ((h "ai.gftd.mangaka.visionScorePanel") {:panel-id "nope"} nil) :no-throw
                  (catch clojure.lang.ExceptionInfo e (:type (ex-data e)))))))

    (testing "enrichScene enriches a stored scene (stub offline) and errors on a missing scene"
      ((h "ai.gftd.mangaka.mangakaGenerateScene") {:prompt "rainy neon alley" :seed 3} nil)
      (let [sid (-> ((h "ai.gftd.mangaka.listScenes") {} nil) :scenes first :id)
            res ((h "ai.gftd.mangaka.enrichScene") {:id sid} nil)]
        (is (= sid (:scene-id res)))
        (is (map? (:enrichment res)))
        (is (false? (:llm-applied res)))            ; offline mock → stub
        (is (map? (store/-read-string store (:scene/enrichment (store/load-scene store sid))))))
      (is (= :bad-input
             (try ((h "ai.gftd.mangaka.enrichScene") {:id "scene-missing"} nil) :no-throw
                  (catch clojure.lang.ExceptionInfo e (:type (ex-data e)))))))

    (testing "enrich_characters runs the LLM path and persists (stub offline)"
      (let [res ((h "ai.gftd.mangaka.enrichCharacters")
                 {:name "Kage" :description "stealthy netrunner" :tags ["hood"]} nil)]
        (is (= "char-kage" (:character-id res)))
        (is (map? (:enrichment res)))
        (is (false? (:llm-applied res)))            ; mock model → stub enrichment offline
        (let [stored (store/load-character store "char-kage")]
          (is (= "Kage" (:character/name stored)))
          (is (map? (store/-read-string store (:character/enrichment stored)))))))

    (testing "lintDocument flags structural storyboard problems (deterministic QA)"
      ;; the seeded GhostHacker cast (char-nei …) is present in this shared store,
      ;; so a focal ref to a real character is clean while a typo'd one is flagged.
      ((h "ai.gftd.mangaka.importGhosthacker") {} nil)
      ((h "ai.gftd.mangaka.saveDocument")
       {:id "lintok" :page {:page/number 1 :page/panels
                            [{:panel/index 0 :panel/rect [0 0 1 1] :panel/focal [":character/Nei"]}]}} nil)
      (let [res ((h "ai.gftd.mangaka.lintDocument") {:doc-id "lintok"} nil)]
        (is (true? (:ok res)) "a well-formed doc with a known character is clean")
        (is (= 0 (:count res))))
      ((h "ai.gftd.mangaka.saveDocument")
       {:id "lintbad" :page {:page/number 1 :page/panels
                             [{:panel/index 0 :panel/focal [":character/Nobody"]}  ; no rect + unknown char
                              {:panel/index 0 :panel/rect [0 0 1 1]}]}} nil)       ; duplicate index
      (let [res ((h "ai.gftd.mangaka.lintDocument") {:doc-id "lintbad"} nil)
            codes (set (map :code (:issues res)))]
        (is (false? (:ok res)))
        (is (contains? codes :missing-rect))
        (is (contains? codes :unknown-character))
        (is (contains? codes :duplicate-index))
        ;; severity breakdown: duplicate-index is the lone error; missing-rect +
        ;; unknown-character are warnings — so the page is not :renderable.
        (is (= 1 (:errors res)) "one error (duplicate-index)")
        (is (= 2 (:warnings res)) "two warnings (missing-rect, unknown-character)")
        (is (= 3 (:count res)))
        (is (false? (:renderable res)) "an error means it won't render correctly"))
      ;; a panel referencing a non-existent scene is flagged (and a real one is clean)
      (let [sid (:scene-id ((h "ai.gftd.mangaka.mangakaGenerateScene") {:prompt "real bg" :seed 2} nil))]
        ((h "ai.gftd.mangaka.saveDocument")
         {:id "lintscn" :page {:page/panels [{:panel/index 0 :panel/rect [0 0 1 1] :panel/scene sid}
                                             {:panel/index 1 :panel/rect [0 0 1 1] :panel/scene "scene-ghost"}]}} nil)
        (let [res ((h "ai.gftd.mangaka.lintDocument") {:doc-id "lintscn"} nil)
              scene-issues (filter #(= :unknown-scene (:code %)) (:issues res))]
          (is (= 1 (count scene-issues)) "only the bogus scene ref is flagged")
          (is (= 1 (:panel (first scene-issues))) "on the panel that references it")))
      ;; a panel whose rect runs off the page is flagged; an in-bounds one is clean
      ((h "ai.gftd.mangaka.saveDocument")
       {:id "lintrect" :page {:page/panels [{:panel/index 0 :panel/rect [0.05 0.05 0.9 0.4]}   ; in bounds
                                            {:panel/index 1 :panel/rect [0.5 0.5 0.9 0.9]}]}} nil) ; x+w=1.4, off page
      (let [issues (:issues ((h "ai.gftd.mangaka.lintDocument") {:doc-id "lintrect"} nil))
            oob (filter #(= :rect-out-of-bounds (:code %)) issues)]
        (is (= 1 (count oob)) "only the overflowing panel is flagged")
        (is (= 1 (:panel (first oob))))
        ;; severities reflect rendering impact: off-page = error, no-rect = warn
        (is (= :error (:severity (first oob))) "out-of-bounds (renders clipped) is an error"))
      ((h "ai.gftd.mangaka.saveDocument") {:id "lintnorect" :page {:page/panels [{:panel/index 0}]}} nil)
      (let [res ((h "ai.gftd.mangaka.lintDocument") {:doc-id "lintnorect"} nil)
            mr (->> (:issues res) (filter #(= :missing-rect (:code %))) first)]
        (is (= :warn (:severity mr)) "missing rect (falls back to default layout) is only a warning")
        ;; warnings-only → not :ok (has an issue) but still :renderable (no errors)
        (is (false? (:ok res)))
        (is (true? (:renderable res)) "a warnings-only doc still renders"))
      ;; an empty document is a (warn-level) issue, not clean — but still renderable
      ((h "ai.gftd.mangaka.saveDocument") {:id "lintempty" :page {:page/number 1 :page/panels []}} nil)
      (let [res ((h "ai.gftd.mangaka.lintDocument") {:doc-id "lintempty"} nil)]
        (is (= [:empty-page] (mapv :code (:issues res))))
        (is (false? (:ok res)))
        (is (true? (:renderable res)) "empty-page is a warning, so the page still renders"))
      ;; missing doc / missing input → :bad-input
      (is (= :bad-input
             (try ((h "ai.gftd.mangaka.lintDocument") {:doc-id "nope"} nil) :no-throw
                  (catch clojure.lang.ExceptionInfo e (:type (ex-data e))))))
      (is (= :bad-input
             (try ((h "ai.gftd.mangaka.lintDocument") {} nil) :no-throw
                  (catch clojure.lang.ExceptionInfo e (:type (ex-data e)))))))

    (testing "generate_page on a missing doc is :bad-input"
      (is (= :bad-input
             (try ((h "ai.gftd.mangaka.mangakaGeneratePage") {:doc-id "nope"} nil) :no-throw
                  (catch clojure.lang.ExceptionInfo e (:type (ex-data e)))))))

    (testing "input validation throws :bad-input for missing required keys"
      (doseq [[nsid input] [["ai.gftd.mangaka.saveDocument" {}]
                            ["ai.gftd.mangaka.mangakaGeneratePanel" {}]
                            ["ai.gftd.mangaka.mangakaGenerateCharacter" {}]
                            ["ai.gftd.mangaka.mangakaGenerateScene" {}]
                            ["ai.gftd.mangaka.mangakaGeneratePage" {}]
                            ["ai.gftd.mangaka.comfyRun" {}]
                            ["ai.gftd.mangaka.enrichCharacters" {}]
                            ["ai.gftd.mangaka.documentsByCharacter" {}]
                            ["ai.gftd.mangaka.visionScorePanel" {}]]]
        (is (= :bad-input
               (try ((h nsid) input nil) :no-throw
                    (catch clojure.lang.ExceptionInfo e (:type (ex-data e))))))))))
