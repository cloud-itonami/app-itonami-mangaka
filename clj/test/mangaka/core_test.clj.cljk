    (testing "generate_page composes the page prompt from the cast and linked scenes"
      (let [sid (:scene-id ((h "ai.gftd.mangaka.mangakaGenerateScene") {:prompt "rainy rooftop at dusk" :seed 4} nil))]
        ((h "ai.gftd.mangaka.saveDocument")
