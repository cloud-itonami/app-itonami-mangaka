    (testing "list endpoints paginate (offset/limit/total per the repo convention)"
      (let [res ((h "ai.gftd.mangaka.listDocuments") {:limit 1} nil)]
        (is (= 1 (:limit res)))
        (is (= 0 (:offset res)))
        (is (int? (:total res)))
        (is (<= (count (:documents res)) 1) "limit slices the result"))
      (let [res ((h "ai.gftd.mangaka.listCharacters") {:offset 0 :limit 2} nil)]
        (is (= 2 (:limit res)))
        (is (<= (count (:characters res)) 2)))
      (let [res ((h "ai.gftd.mangaka.listScenes") {} nil)]
        (is (= 100 (:limit res)) "default limit")
        (is (int? (:total res))))
      (testing "bad offset/limit (JSON string, negative, garbage) coerce to safe defaults — never 500"
        ;; a JSON client may send {"limit":"1"}; "abc"/negative must not crash
        (let [res ((h "ai.gftd.mangaka.listDocuments") {:limit "1" :offset "0"} nil)]
          (is (= 1 (:limit res)) "string \"1\" coerced to 1")
          (is (<= (count (:documents res)) 1)))
        (let [res ((h "ai.gftd.mangaka.listCharacters") {:limit "abc" :offset -5} nil)]
          (is (= 100 (:limit res)) "non-numeric limit → default 100")
          (is (= 0 (:offset res)) "negative offset → clamped to 0"))))

