    (testing "lintDocument flags structural storyboard problems (deterministic QA)"
      ;; the seeded GhostHacker cast (char-nei …) is present in this shared store,
      ;; so a focal ref to a real character is clean while a typo'd one is flagged.
      ((h "ai.gftd.mangaka.importGhosthacker") {} nil)
      ((h "ai.gftd.mangaka.saveDocument")
       {:id "lintok" :page {:page/number 1 :page/panels
                            [{:panel/index 0 :panel/rect [0 0 1 1] :panel/focal [":character/Nei"]}]}} nil)
      (let [res ((h "ai.gftd.mangaka.lintDocument") {:doc-id "lintok"} nil)]
        (is (true? (:ok res)) "a well-formed doc with a known character is clean")
        (is (= 0 (:count res))))
      ((h "ai.gftd.mangaka.saveDocument")
       {:id "lintbad" :page {:page/number 1 :page/panels
                             [{:panel/index 0 :panel/focal [":character/Nobody"]}  ; no rect + unknown char
                              {:panel/index 0 :panel/rect [0 0 1 1]}]}} nil)       ; duplicate index
      (let [res ((h "ai.gftd.mangaka.lintDocument") {:doc-id "lintbad"} nil)
            codes (set (map :code (:issues res)))]
        (is (false? (:ok res)))
        (is (contains? codes :missing-rect))
        (is (contains? codes :unknown-character))
        (is (contains? codes :duplicate-index))
        ;; severity breakdown: duplicate-index is the lone error; missing-rect +
        ;; unknown-character are warnings — so the page is not :renderable.
        (is (= 1 (:errors res)) "one error (duplicate-index)")
        (is (= 2 (:warnings res)) "two warnings (missing-rect, unknown-character)")
        (is (= 3 (:count res)))
        (is (false? (:renderable res)) "an error means it won't render correctly"))
      ;; a panel referencing a non-existent scene is flagged (and a real one is clean)
      (let [sid (:scene-id ((h "ai.gftd.mangaka.mangakaGenerateScene") {:prompt "real bg" :seed 2} nil))]
        ((h "ai.gftd.mangaka.saveDocument")
         {:id "lintscn" :page {:page/panels [{:panel/index 0 :panel/rect [0 0 1 1] :panel/scene sid}
                                             {:panel/index 1 :panel/rect [0 0 1 1] :panel/scene "scene-ghost"}]}} nil)
        (let [res ((h "ai.gftd.mangaka.lintDocument") {:doc-id "lintscn"} nil)
              scene-issues (filter #(= :unknown-scene (:code %)) (:issues res))]
          (is (= 1 (count scene-issues)) "only the bogus scene ref is flagged")
          (is (= 1 (:panel (first scene-issues))) "on the panel that references it")))
      ;; a panel whose rect runs off the page is flagged; an in-bounds one is clean
      ((h "ai.gftd.mangaka.saveDocument")
       {:id "lintrect" :page {:page/panels [{:panel/index 0 :panel/rect [0.05 0.05 0.9 0.4]}   ; in bounds
                                            {:panel/index 1 :panel/rect [0.5 0.5 0.9 0.9]}]}} nil) ; x+w=1.4, off page
      (let [issues (:issues ((h "ai.gftd.mangaka.lintDocument") {:doc-id "lintrect"} nil))
            oob (filter #(= :rect-out-of-bounds (:code %)) issues)]
        (is (= 1 (count oob)) "only the overflowing panel is flagged")
        (is (= 1 (:panel (first oob))))
        ;; severities reflect rendering impact: off-page = error, no-rect = warn
        (is (= :error (:severity (first oob))) "out-of-bounds (renders clipped) is an error"))
      ((h "ai.gftd.mangaka.saveDocument") {:id "lintnorect" :page {:page/panels [{:panel/index 0}]}} nil)
      (let [res ((h "ai.gftd.mangaka.lintDocument") {:doc-id "lintnorect"} nil)
            mr (->> (:issues res) (filter #(= :missing-rect (:code %))) first)]
        (is (= :warn (:severity mr)) "missing rect (falls back to default layout) is only a warning")
        ;; warnings-only → not :ok (has an issue) but still :renderable (no errors)
        (is (false? (:ok res)))
        (is (true? (:renderable res)) "a warnings-only doc still renders"))
      ;; an empty document is a (warn-level) issue, not clean — but still renderable
      ((h "ai.gftd.mangaka.saveDocument") {:id "lintempty" :page {:page/number 1 :page/panels []}} nil)
      (let [res ((h "ai.gftd.mangaka.lintDocument") {:doc-id "lintempty"} nil)]
        (is (= [:empty-page] (mapv :code (:issues res))))
        (is (false? (:ok res)))
        (is (true? (:renderable res)) "empty-page is a warning, so the page still renders"))
      ;; missing doc / missing input → :bad-input
      (is (= :bad-input
             (try ((h "ai.gftd.mangaka.lintDocument") {:doc-id "nope"} nil) :no-throw
                  (catch clojure.lang.ExceptionInfo e (:type (ex-data e))))))
      (is (= :bad-input
             (try ((h "ai.gftd.mangaka.lintDocument") {} nil) :no-throw
                  (catch clojure.lang.ExceptionInfo e (:type (ex-data e)))))))

    (testing "generate_page on a missing doc is :bad-input"
      (is (= :bad-input
             (try ((h "ai.gftd.mangaka.mangakaGeneratePage") {:doc-id "nope"} nil) :no-throw
                  (catch clojure.lang.ExceptionInfo e (:type (ex-data e)))))))

    (testing "composeKomawari proposes komawari geometry and persists only when the governor is satisfied"
      (let [rows [[{:panel/id 1 :dialogue "a" :beat/weight :medium}
                   {:panel/id 2 :dialogue "b" :beat/weight :small}]
                  [{:panel/id 3 :dialogue "c" :beat/weight :large
                    :beat/intensity :impact :beat/vector 20}]]
            res ((h "ai.gftd.mangaka.composeKomawari") {:id "kw1" :title "Impact" :rows rows} nil)]
        (is (true? (:ok res)))
        (is (true? (:ok? (:report res))) "governor is satisfied")
        (is (string? (:svg res)))
        (is (str/includes? (:svg res) "<polygon") "the sheared impact row renders as a polygon")
        (is (= 3 (count (:page/panels (:page (store/load-document store "kw1"))))) "persisted")
        ;; a golden-ratio split: the :medium panel reads ~φ:1 against its :small neighbor
        (let [[p1 p2] (:page/panels (:page (store/load-document store "kw1")))
              w1 (nth (:panel/rect p1) 2) w2 (nth (:panel/rect p2) 2)]
          (is (< 1.5 (/ w1 w2) 1.7) "medium:small width ratio is ~φ"))
        ;; :style passes through the graph (not just the pure fn) — :togashi
        ;; disables tilt even on an :impact row (ADR-2607051530)
        (let [res2 ((h "ai.gftd.mangaka.composeKomawari")
                    {:id "kw-togashi" :rows rows :style :togashi} nil)
              panel3 (nth (:page/panels (:page (store/load-document store "kw-togashi"))) 2)]
          (is (true? (:ok res2)))
          (is (nil? (:panel/tilt panel3)) "togashi style rejects the shear even on the :impact beat")))
      ;; an illegal hand-authored tilt fails the governor and is NOT persisted
      (let [bad-rows [[{:panel/id 1 :panel/rect [0 0 1 0.9] :panel/tilt 60}]]
            res ((h "ai.gftd.mangaka.composeKomawari") {:id "kw-bad" :rows bad-rows} nil)]
        (is (false? (:ok res)))
        (is (nil? (store/load-document store "kw-bad")) "a governor-rejected layout is never written")))

    (testing "input validation throws :bad-input for missing required keys"
      (doseq [[nsid input] [["ai.gftd.mangaka.saveDocument" {}]
                            ["ai.gftd.mangaka.mangakaGeneratePanel" {}]
                            ["ai.gftd.mangaka.mangakaGenerateCharacter" {}]
                            ["ai.gftd.mangaka.mangakaGenerateScene" {}]
                            ["ai.gftd.mangaka.mangakaGeneratePage" {}]
                            ["ai.gftd.mangaka.comfyRun" {}]
                            ["ai.gftd.mangaka.enrichCharacters" {}]
                            ["ai.gftd.mangaka.documentsByCharacter" {}]
                            ["ai.gftd.mangaka.visionScorePanel" {}]
                            ["ai.gftd.mangaka.composeKomawari" {}]]]
        (is (= :bad-input
               (try ((h nsid) input nil) :no-throw
                    (catch clojure.lang.ExceptionInfo e (:type (ex-data e))))))))))

(deftest analyze-expression-inline
  (testing "inline authoring page: 叫び→spike/heavy/大, ざわめき→faint/小/群衆トーン"
    (let [store (store/mem-store)
          entry (reg/resolve-entry (reg/build store (rt/scratch-conn))
                                   "ai.gftd.mangaka.analyzeExpression")
          r ((:handler entry)
             {:page {:panels [{:characters ["ガター"]
                               :dialogue [{:speaker "ガター" :text "バカな！！" :intensity 1.0}]}
                              {:dialogue [{:text "ざわ" :register :chatter}]}]}
              :cast {"ガター" "hot-blooded"}}
             "t-inline")
          [p0 p1] (:panels (:page r))
          d0 (first (:dialogue p0))]
      (is (= :spike (:bubble d0)))
      (is (= :heavy (:weight d0)))
      (is (> (:scale d0) 1.5) "強度で文字が大きい")
      (is (= :crowd-silhouette (:tone p1)) "ざわめきパネルは群衆シルエット")
      (is (= {:panels 2 :bubbles 2} (:analysis r)))
      (is (false? (:persisted r)) "inline は保存しない"))))

(deftest analyze-expression-stored-doc
  (testing "stored domain doc (:id): :panel/bubbles + :panel/tone を enrich して永続化"
    (let [store (store/mem-store)
          _ (store/save-document!
             store {:id "hx1"
                    :page {:page/number 1
                           :page/panels [{:panel/index 0 :panel/focal ["Gatta"]
                                          :panel/bubbles [{:bubble/text "バカな！！"
                                                           :bubble/intensity 1.0}]}]}})
          entry (reg/resolve-entry (reg/build store (rt/scratch-conn))
                                   "ai.gftd.mangaka.analyzeExpression")
          r ((:handler entry) {:id "hx1" :cast {"Gatta" "hot-blooded"}} "t-doc")
          panel  (first (:page/panels (:page (store/load-document store "hx1"))))
          bubble (first (:panel/bubbles panel))]
      (is (true? (:persisted r)))
      (is (= "spike" (:bubble/shape bubble)))
      (is (= "heavy" (:bubble/weight bubble)) "文字の薄さ→太さが round-trip する")
      (is (= "shout" (:bubble/register bubble)))
      (is (contains? #{"flash" "focus-lines"} (:panel/tone panel)) "背景トーンが付く"))))

(deftest analyze-expression-auto-cast-from-store
  (testing "focal キャラの enrichment(:archetype) から cast を自動解決 (手渡し :cast 不要)"
    (let [store (store/mem-store)
          _ (store/save-character! store {:id "char-gatta" :name "Gatta"
                                          :enrichment (pr-str {:archetype "hot-blooded"})})
          _ (store/save-document!
             store {:id "hxauto"
                    :page {:page/number 1
                           :page/panels [{:panel/index 0 :panel/focal ["Gatta"]
                                          :panel/bubbles [{:bubble/text "バカな！！"
                                                           :bubble/intensity 1.0}]}]}})
          entry (reg/resolve-entry (reg/build store (rt/scratch-conn))
                                   "ai.gftd.mangaka.analyzeExpression")
          r ((:handler entry) {:id "hxauto"} "t-auto")            ; NO :cast passed
          bubble (first (:panel/bubbles (first (:page/panels (:page (store/load-document store "hxauto"))))))]
      (is (= :hot-blooded (get (:cast r) "Gatta")) "archetype resolved from enrichment")
      (is (= "spike" (:bubble/shape bubble)))
      (is (= "heavy" (:bubble/weight bubble)))))
  (testing "enrichment に :archetype が無くても role/personality から推定される"
    (is (= :cold-menace (analyze-expr/infer-archetype "a cold, ruthless assassin")))
    (is (= :strategist (analyze-expr/infer-archetype "冷静な参謀")))
    (is (nil? (analyze-expr/infer-archetype "someone")))))
