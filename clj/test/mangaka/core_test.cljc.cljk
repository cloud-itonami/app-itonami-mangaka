    (testing "deleteCharacter / deleteScene prune generated assets (idempotent; missing input → 400)"
      ((h "ai.gftd.mangaka.mangakaGenerateCharacter") {:name "Junk" :seed 1} nil)
      (let [sid (:scene-id ((h "ai.gftd.mangaka.mangakaGenerateScene") {:prompt "throwaway bg" :seed 1} nil))]
        (is (some? (store/load-character store "char-junk")))
        (is (some? (store/load-scene store sid)))
        ;; character delete
        (is (= {:id "char-junk" :deleted true} ((h "ai.gftd.mangaka.deleteCharacter") {:id "char-junk"} nil)))
        (is (nil? (store/load-character store "char-junk")) "character gone after delete")
        (is (not (contains? (set (map :id (:characters ((h "ai.gftd.mangaka.listCharacters") {} nil)))) "char-junk")))
        (is (= {:id "char-junk" :deleted false} ((h "ai.gftd.mangaka.deleteCharacter") {:id "char-junk"} nil))
            "idempotent")
        ;; scene delete
        (is (:deleted ((h "ai.gftd.mangaka.deleteScene") {:id sid} nil)))
        (is (nil? (store/load-scene store sid)) "scene gone after delete"))
      (is (= :bad-input
             (try ((h "ai.gftd.mangaka.deleteCharacter") {} nil) :no-throw
                  (catch clojure.lang.ExceptionInfo e (:type (ex-data e)))))))

