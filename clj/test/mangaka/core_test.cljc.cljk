        (is (contains? (set (:documents res)) "qd"))
        (is (= {:doc-id "qd" :index 0} (first (filter #(= "qd" (:doc-id %)) (:panels res))))))
      ;; case-insensitive: lowercase "nei" and full-ref forms resolve to the
      ;; canonical stored focal ref :character/Nei (the model's casing varies)
      (doseq [arg ["nei" "NEI" ":character/nei"]]
        (let [res ((h "ai.gftd.mangaka.documentsByCharacter") {:character arg} nil)]
          (is (= ":character/Nei" (:character res)) (str arg " resolves to canonical ref"))
          (is (contains? (set (:documents res)) "qd") (str arg " finds the document"))))
      (let [res ((h "ai.gftd.mangaka.documentsByCharacter") {:character ":character/Ghost"} nil)]
        (is (= [] (:documents res)))))

