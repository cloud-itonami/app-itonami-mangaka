(ns mangaka-reader.render
  "Pure rendering/projection for the manga.gftd.ai reader (cljc rewrite of
  the recovered JS Worker, ADR-2607070500 follow-up).

  The 作品一覧 index is now SSR'd through kotoba-lang/manga-viewer
  (works-grid hiccup → shitsuke.hiccup/->html) — the same view code the
  aozora.app /manga viewer compiles in, unifying the two viewer surfaces.
  The work reader page keeps byte-parity with the proven DATA-driven client
  reader (mangaka-reader.assets). All fns are pure; D1/R2/auth live in
  mangaka-reader.worker."
  (:require [kotoba.lang.text :as str]
            [manga-viewer.render :as mv]
            [manga-viewer.style :as mv-style]
            [mangaka-reader.assets :as assets]
            [shitsuke.hiccup :as hiccup]))

(def footer
  "mangaka.gftd.ai · AI-generated manga · 公開: D1 + R2 (RunPod不使用 / Tailscale生成)")

(defn esc [s]
  (-> (str (or s ""))
      (str/replace "&" "&amp;")
      (str/replace "<" "&lt;")
      (str/replace ">" "&gt;")
      (str/replace "\"" "&quot;")
      (str/replace "'" "&#39;")))

(defn url-encode [s]
  #?(:cljs (js/encodeURIComponent (str s))
     :clj (java.net.URLEncoder/encode (str s) "UTF-8")))

(defn page-shell
  "Full HTML document — same skeleton/head CSS as the original shell()."
  [title body-html extra-css]
  (str "<!doctype html><html lang=\"ja\"><head><meta charset=\"utf-8\">\n"
       "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n"
       "<meta name=\"theme-color\" content=\"#0c0e14\">\n"
       "<title>" (esc title) "</title>\n"
       "<style>\n" assets/shell-css "\n" (or extra-css "") "\n</style></head>"
       "<body>" body-html "</body></html>"))

;; ── 作品一覧 (manga-viewer SSR) ──────────────────────────────────────────────

(defn genre-tags [genre]
  (vec (remove str/blank? (map str/trim (str/split (str (or genre "")) #"[×・/、,]")))))

(defn row->index-work
  "D1 work row (+ resolved cover blob key) → manga-viewer index work."
  [{:keys [rkey title name props cover]}]
  (cond-> {:manga/id rkey
           :manga/title (or title name rkey)
           :manga/author (or (:author props) "—")
           :manga/episode (or (:series props) "—")
           :manga/tags (genre-tags (:genre props))
           :manga/url (str "/work/" (url-encode rkey))}
    cover (assoc :manga/cover (str "/img/" (url-encode cover)))
    (:pageCount props) (assoc :manga/page-count (:pageCount props))))

(def ^:private index-css
  (str "main{max-width:1040px;margin:0 auto;padding:24px}\n"
       "footer{color:#6b7488;font-size:12px;text-align:center;padding:32px 16px}\n"
       (mv-style/css)))

(defn index-html [index-works]
  (page-shell
   "Mangaka — 作品一覧"
   (str "<header><h1>Mangaka 作品一覧</h1>"
        "<div class=\"sub\">作者・作品・シリーズごとの公開ビューア</div></header>"
        "<main>"
        (if (seq index-works)
          (hiccup/->html (mv/works-grid index-works {:href-fn :manga/url}))
          "<p class=\"sub\">まだ公開作品がありません。</p>")
        "</main><footer>" (esc footer) "</footer>")
   index-css))

;; ── work reader page (DATA-driven client reader, byte-parity) ───────────────

(defn version-nav
  "バージョン切替バー — 同じ versionGroup の work 群 (versions.edn が SSoT、
  D1 props はその projection)。2 件未満なら描かない。"
  [versions]
  (if (< (count versions) 2)
    ""
    (str "<nav class=\"versions\" style=\"display:flex;gap:8px;align-items:center;"
         "flex-wrap:wrap;padding:8px 16px;background:#15151a;"
         "font:13px/1.6 -apple-system,sans-serif;color:#9a9aa4\">"
         "<span>version:</span>"
         (apply str
                (for [{:keys [rkey label current?]} versions]
                  (if current?
                    (str "<b style=\"color:#fff;background:#7c4dff;border-radius:10px;"
                         "padding:2px 10px\">" (esc label) "</b>")
                    (str "<a style=\"color:#8b96ff;border:1px solid #333;border-radius:10px;"
                         "padding:2px 10px;text-decoration:none\" href=\"/work/"
                         (esc rkey) "\">" (esc label) "</a>"))))
         "</nav>")))

(defn work-html
  "Reader page for one work. `data-json` is the pre-encoded JSON of
  {title, author, pages:[{n,src}]} (the client reader's DATA bootstrap).
  `:versions` (optional) renders the version-switch bar above the reader."
  [{:keys [title author versions]} data-json]
  (page-shell
   (str title " — Mangaka")
   (str (version-nav versions)
        (assets/reader-body (esc title) (esc author) data-json))
   assets/reader-css))

(defn not-found-html []
  (page-shell
   "404"
   (str "<header><h1>404</h1></header><main style=\"padding:24px\">"
        "<p class=\"sub\">作品が見つかりません。<a href=\"/\">← 一覧</a></p></main>")
   nil))

;; ── JSON shapes ──────────────────────────────────────────────────────────────

(defn work-json
  "GET /api/work/:rkey response map."
  [{:keys [rkey title name props]} pages]
  {:rkey rkey
   :title (or title name)
   :author (or (:author props) "")
   :series (or (:series props) "")
   :genre (or (:genre props) "")
   :logline (or (:logline props) "")
   :pageCount (:pageCount props)
   :pages pages})

(defn works-json
  "GET /api/works response map."
  [rows]
  {:works (mapv (fn [{:keys [rkey title name props cover]}]
                  {:rkey rkey
                   :title (or title name rkey)
                   :author (or (:author props) "")
                   :series (or (:series props) "")
                   :genre (or (:genre props) "")
                   :pageCount (:pageCount props)
                   :logline (or (:logline props) "")
                   :cover (when cover (str "/img/" (url-encode cover)))})
                rows)})

;; ── work-meta update (POST /api/work/:rkey) ──────────────────────────────────

(def updatable-props [:author :series :genre :logline])

(defn merge-work-props
  "Whitelisted string fields from the update body into the stored props."
  [props body]
  (reduce (fn [p k]
            (let [v (get body k)]
              (if (string? v) (assoc p k v) p)))
          (or props {})
          updatable-props))

(defn pick-title [body current]
  (let [t (:title body)]
    (if (and (string? t) (not (str/blank? t))) (str/trim t) current)))

;; ── page blobKey update (POST /api/work/:rkey/page/:n) ──────────────────────

(defn merge-page-props
  "Page-row props update — only :blobKey is studio-editable (re-render
  cache-busting, e.g. the yamainu-1-p01 → -v2 convention); everything else
  (workRkey linkage etc.) is the fleet publish path's."
  [props body]
  (let [v (:blobKey body)]
    (if (and (string? v) (not (str/blank? v)))
      (assoc (or props {}) :blobKey (str/trim v))
      (or props {}))))

(defn parse-page-path
  "Parse /api/work/<rkey>/page/<n> → {:rkey :page-number} | nil."
  [path]
  (when-let [[_ rkey n] (re-matches #"/api/work/(.+)/page/(\d+)" path)]
    {:rkey rkey :page-number (long #?(:cljs (js/parseInt n 10)
                                      :clj (Long/parseLong n)))}))
