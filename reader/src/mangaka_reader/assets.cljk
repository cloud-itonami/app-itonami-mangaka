(ns mangaka-reader.assets
  "Verbatim template assets of the manga.gftd.ai reader — extracted
  mechanically from the previously deployed Worker script (reader/src/index.js
  in git history) so the cljc rewrite keeps byte-parity on the CSS and the
  DATA-driven client reader JS."
  (:require [kotoba.lang.text :as str]))

(def shell-css
  "Shared page-shell head CSS (dark reader base)."
  ":root{color-scheme:dark}\n*{box-sizing:border-box}\nhtml,body{margin:0;height:100%}\nbody{background:#0c0e14;color:#e8eaf0;font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",\"Hiragino Sans\",Meiryo,sans-serif;line-height:1.6;-webkit-font-smoothing:antialiased}\na{color:#7fb0ff;text-decoration:none}\nheader{padding:18px 24px;border-bottom:1px solid #232838;position:sticky;top:0;background:rgba(12,14,20,.92);backdrop-filter:blur(10px);z-index:30}\nh1{margin:0;font-size:20px;letter-spacing:.02em}\n.sub{color:#9aa3b8;font-size:13px;margin-top:4px}")

(def reader-css
  "Work reader page CSS (bar / stage / spread / scroll / zones / count)."
  "body{overflow:hidden}\n#bar{display:flex;align-items:center;gap:14px;padding:10px 16px;border-bottom:1px solid #232838;background:rgba(12,14,20,.92);backdrop-filter:blur(10px);position:fixed;top:0;left:0;right:0;height:52px;z-index:40;transition:transform .25s}\n#bar.hide{transform:translateY(-100%)}\n#bar h1{font-size:15px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:42vw}\n#bar .meta{color:#9aa3b8;font-size:12px;white-space:nowrap}\n#bar .spacer{flex:1}\n.btn{background:#1d2233;border:1px solid #2b3147;color:#dbe2f4;border-radius:8px;padding:6px 10px;font-size:13px;cursor:pointer;line-height:1}\n.btn:hover{border-color:#3a64b0}\n.btn.on{background:#274062;border-color:#3a64b0}\n#stage{position:fixed;inset:52px 0 0 0;display:flex;align-items:center;justify-content:center;background:#070810;overflow:hidden;touch-action:pan-y}\n#stage.full{inset:0}\n.spread{display:flex;align-items:center;justify-content:center;gap:2px;height:100%;width:100%;padding:10px}\n.spread img{max-height:100%;max-width:100%;object-fit:contain;background:#000;box-shadow:0 4px 24px rgba(0,0,0,.6)}\n#scroll{position:fixed;inset:52px 0 0 0;overflow-y:auto;display:none;flex-direction:column;align-items:center;gap:10px;padding:16px;background:#070810}\n#scroll img{width:100%;max-width:820px;height:auto;border-radius:4px;background:#000}\n.zone{position:absolute;top:0;bottom:0;width:34%;z-index:10;cursor:pointer}\n.zone.left{left:0}.zone.right{right:0}\n#count{position:fixed;bottom:14px;left:50%;transform:translateX(-50%);background:rgba(20,24,36,.85);border:1px solid #2b3147;border-radius:999px;padding:5px 14px;font-size:13px;color:#cdd5ea;z-index:40;transition:opacity .25s}\n#count.hide{opacity:0}\n#hint{position:fixed;bottom:54px;left:50%;transform:translateX(-50%);color:#6b7488;font-size:11px;z-index:40}\nfooter{display:none}")

(def reader-body-template
  "Reader page body skeleton. Placeholders: {{TITLE}} (escaped work title),
  {{AUTHOR}} (escaped author)."
  "\n<div id=\"bar\">\n  <a href=\"/\" class=\"btn\" title=\"作品一覧\">←</a>\n  <h1>{{TITLE}}</h1>\n  <span class=\"meta\">{{AUTHOR}}</span>\n  <span class=\"spacer\"></span>\n  <button class=\"btn\" id=\"m-spread\" title=\"見開き(右→左)\">見開き</button>\n  <button class=\"btn\" id=\"m-single\" title=\"単ページ\">単頁</button>\n  <button class=\"btn\" id=\"m-scroll\" title=\"縦スクロール\">縦読</button>\n  <button class=\"btn\" id=\"b-full\" title=\"全画面\">⛶</button>\n</div>\n<div id=\"stage\"><div class=\"spread\" id=\"spread\"></div>\n  <div class=\"zone left\" id=\"z-left\"></div><div class=\"zone right\" id=\"z-right\"></div>\n</div>\n<div id=\"scroll\"></div>\n<div id=\"count\"></div>\n<div id=\"hint\">← 次へ　/　→ 前へ　/　F 全画面　/　画面端タップ</div>\n")

(def reader-client-js
  "DATA-driven client reader (spread/single/scroll, RTL zones, keys,
  fullscreen, bar auto-hide). `const DATA = <json>;` is prepended at render."
  "const pages = DATA.pages || [];\nconst stage = document.getElementById('stage'), spread = document.getElementById('spread');\nconst scroll = document.getElementById('scroll'), bar = document.getElementById('bar');\nconst countEl = document.getElementById('count'), hint = document.getElementById('hint');\nlet mode = (matchMedia('(max-width:820px)').matches ? 'single' : 'spread');\nlet idx = 0;            // current page index (0-based)\nlet units = [];         // array of [pageIdx...] groups for the active mode\n\nfunction preload(i){ if(i>=0&&i<pages.length){const im=new Image(); im.src=pages[i].src;} }\n\n// Build display units. Spread = RTL: cover alone, then pairs with the\n// higher page number on the LEFT and lower on the RIGHT.\nfunction buildUnits(){\n  if(mode==='spread'){\n    units=[]; if(pages.length){units.push([0]);} let i=1;\n    while(i<pages.length){ units.push(i+1<pages.length?[i,i+1]:[i]); i+=2; }\n  } else { units = pages.map((_,i)=>[i]); }\n}\n\nfunction unitOf(pageIdx){ return units.findIndex(u=>u.includes(pageIdx)); }\n\nfunction render(){\n  if(mode==='scroll'){ stage.style.display='none'; scroll.style.display='flex'; return; }\n  stage.style.display='flex'; scroll.style.display='none';\n  buildUnits();\n  let ui = unitOf(idx); if(ui<0) ui=0;\n  const u = units[ui] || [0];\n  // RTL: render right page first visually means putting lower-numbered page\n  // on the RIGHT. flex row with the pair reversed (higher index left).\n  const order = mode==='spread' ? [...u].reverse() : u;  // [hi, lo] → left,right\n  spread.innerHTML = order.map(i=>'<img src=\"'+pages[i].src+'\" alt=\"p'+pages[i].n+'\">').join('');\n  idx = u[0];\n  // preload neighbours\n  const last = u[u.length-1];\n  preload(last+1); preload(last+2); preload(u[0]-1);\n  updateCount(u);\n}\n\nfunction updateCount(u){\n  const ns = u.map(i=>pages[i].n);\n  const label = ns.length>1 ? ns[ns.length-1]+'–'+ns[0] : ns[0];\n  countEl.textContent = label + ' / ' + pages.length;\n}\n\nfunction next(){ // RTL forward (leftward)\n  if(mode==='scroll') return;\n  const ui = unitOf(idx); if(ui<units.length-1){ idx = units[ui+1][0]; render(); }\n}\nfunction prev(){\n  if(mode==='scroll') return;\n  const ui = unitOf(idx); if(ui>0){ idx = units[ui-1][0]; render(); }\n}\n\nfunction setMode(m){\n  mode=m;\n  for(const id of ['spread','single','scroll']) document.getElementById('m-'+id).classList.toggle('on', id===m);\n  if(m==='scroll'){\n    if(!scroll.dataset.built){ scroll.innerHTML = pages.map(p=>'<img loading=\"lazy\" src=\"'+p.src+'\" alt=\"p'+p.n+'\">').join(''); scroll.dataset.built='1'; }\n  }\n  render();\n}\n\n// Build vertical-scroll lazily handled in setMode. Default render.\nsetMode(mode);\npreload(0); preload(1);\n\n// Controls\ndocument.getElementById('m-spread').onclick=()=>setMode('spread');\ndocument.getElementById('m-single').onclick=()=>setMode('single');\ndocument.getElementById('m-scroll').onclick=()=>setMode('scroll');\ndocument.getElementById('z-left').onclick=next;   // left zone = next (RTL)\ndocument.getElementById('z-right').onclick=prev;  // right zone = prev\ndocument.getElementById('b-full').onclick=toggleFull;\n\nfunction toggleFull(){\n  if(!document.fullscreenElement){ document.documentElement.requestFullscreen?.(); }\n  else { document.exitFullscreen?.(); }\n}\ndocument.addEventListener('fullscreenchange',()=>{\n  const f = !!document.fullscreenElement;\n  document.getElementById('b-full').classList.toggle('on', f);\n  bar.classList.toggle('hide', f); stage.classList.toggle('full', f);\n});\n\naddEventListener('keydown', e=>{\n  if(e.key==='ArrowLeft'||e.key===' '){ next(); e.preventDefault(); }\n  else if(e.key==='ArrowRight'){ prev(); }\n  else if(e.key==='f'||e.key==='F'){ toggleFull(); }\n  else if(e.key==='Home'){ idx=0; render(); }\n  else if(e.key==='End'){ idx=pages.length-1; render(); }\n});\n\n// Swipe (touch) — swipe left = next (RTL forward)\nlet tx=0; stage.addEventListener('touchstart',e=>tx=e.touches[0].clientX,{passive:true});\nstage.addEventListener('touchend',e=>{const dx=e.changedTouches[0].clientX-tx; if(Math.abs(dx)>50){ dx<0?next():prev(); }});\n\n// Auto-hide the count after a moment of no nav\nlet t; function poke(){ countEl.classList.remove('hide'); hint.style.opacity='1'; clearTimeout(t); t=setTimeout(()=>{countEl.classList.add('hide'); hint.style.opacity='0';},2200); }\naddEventListener('keydown',poke); stage.addEventListener('click',poke); poke();\n")

(defn reader-body
  "Fill the skeleton and inline the client reader with its DATA bootstrap
  (data-json must be a pre-encoded JSON string)."
  [escaped-title escaped-author data-json]
  (str (-> reader-body-template
           (str/replace "{{TITLE}}" escaped-title)
           (str/replace "{{AUTHOR}}" escaped-author))
       "<script>\nconst DATA = " data-json ";\n" reader-client-js "\n</script>"))
