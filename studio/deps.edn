;; mangaka studio — the 原稿 editor surface, at app.itonami.cloud/mangaka/.
;;
;; The reader (../reader) shows a finished work. This shows the same work as
;; something you can still work on: the published page goes under the paper as
;; a traced underlay, and コマ割り / ふきだし / トーン / 文字 go on top.
;;
;; There is no source here beyond a page generator and a Worker config. The
;; editor is `kotoba-lang/kami-genko`, consumed as a library — this directory
;; owns *where it is published*, not what it is. That split is why the studio
;; page is generated by `kami.mangaka.genko-theme/->page-html` rather than
;; written here: two repos rendering the same page from two copies of a
;; generator is how the two surfaces drift.
{:paths []

 :deps {org.clojure/clojure {:mvn/version "1.12.0"}

        ;; The editor. Pinned to a merged commit on kami-genko's main, per the
        ;; workspace rule that a pin must be reachable from the default branch.
        io.github.kotoba-lang/kami-genko
        {:git/url "https://github.com/kotoba-lang/kami-genko.git"
         :git/sha "c6cf1723aa34ae325e8d253ba4617e2b4e01a7f5"}}

 :aliases
 {;; shadow-cljs compiles the editor's own `genko-app` entry point from the
  ;; library's classpath — the same build kami-genko runs for its own surface,
  ;; so the studio cannot end up on a different bundle than the one that was
  ;; tested.
  :cljs {:extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}
                      thheller/shadow-cljs      {:mvn/version "2.28.20"}
                      reagent/reagent           {:mvn/version "1.2.0"}}}}}
